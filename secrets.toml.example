# Đổi tên file này thành .streamlit/secrets.toml (KHÔNG commit lên git công khai)
# rồi đặt mật khẩu riêng cho tính năng Đối chiếu lưu trú tại đây.
recon_pass = "368736"

# ── (Tùy chọn) Lưu trữ đám mây cho Sổ giao ca — Supabase/Postgres ──────────
# Không bắt buộc: nếu bỏ trống mục này, Sổ giao ca vẫn hoạt động bình thường,
# chỉ lưu tạm trên đĩa server trong ngày (mất khi app deploy lại, không xem
# lại được lịch sử nhiều ngày). Cấu hình mục dưới đây để Sổ giao ca lưu bền
# vững trên Supabase — không mất dữ liệu qua các lần deploy, xem lại được
# mọi ngày trong quá khứ, và tự tổng hợp số liệu theo ngày.
#
# Cách lấy connection string:
#   1. Tạo tài khoản + dự án miễn phí tại https://supabase.com
#   2. Vào Project Settings → Database → Connection string → chọn "URI"
#      (dùng mục "Connection pooling" nếu có, ổn định hơn cho ứng dụng web)
#   3. Dán vào bên dưới, thay [YOUR-PASSWORD] bằng mật khẩu database thật
#   4. Trên Streamlit Cloud: dán TOÀN BỘ nội dung file này (đã điền secrets
#      thật) vào App settings → Secrets — KHÔNG commit file đã điền lên GitHub
#
# [connections.supabase_db]
# url = "postgresql+psycopg2://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
